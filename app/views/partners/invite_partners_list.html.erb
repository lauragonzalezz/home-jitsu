<div class="component-container">
  <h1 class="h2 text-center">Which of your partners is perfect for your event?</h1>
  <% current_user.friends.each do |friend| %>
    <div class="card-box bg-white">
      <div class="d-flex card-grid">
        <%= link_to user_path(friend) do %>
          <% if friend.photo.key %>
            <%= cl_image_tag friend.photo.key, crop: :thumb, class: "rounded-circle avatar" %>
          <% else %>
            <%= image_tag "avatar.svg", alt: "", width: 40, class: "avatar" %>
          <% end %>
        <% end %>
        <%= render "shared/user_summary", user: friend, link: true %>
        <div class="d-flex align-items-center">
          <% if !@guests_ids.include?(friend.id) %>
            <%= button_to "Invite",  {:controller => "guests", :action => "invite", :event_id => @event.id, :guest_id => friend.id },  {:method=>:post, class: "btn btn-xs btn-primary d-block w-100", data: { turbo_submits_with: "Inviting…" }} %>
          <% else %>
            <small>Invited</small>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>
