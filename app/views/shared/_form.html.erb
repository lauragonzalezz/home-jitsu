<div class="form-inputs">

  <%= field.input :first_name,
              required: true,
              autofocus: true,
              label: "First name",
              label_html: { class: "visually-hidden" },
              placeholder: "First name *",
              input_html: { autocomplete: "given-name" }%>
  <%= field.input :last_name,
              required: true,
              label: "Last name",
              label_html: { class: "visually-hidden" },
              placeholder: "Last name *",
              input_html: { autocomplete: "family-name" }%>
  <%= field.input :address,
              hint: "This won't be public! Just make sure it's a real address or you will miss a lot of our features",
              required: true,
              label: "Address",
              label_html: { class: "visually-hidden" },
              placeholder: "Address *",
              input_html: { autocomplete: "street-address" } %>
  <%= field.input :gender, collection: User::GENDERS,
              required: true,
              label: "Gender",
              label_html: { class: "visually-hidden" },
              prompt: "Gender *" %>
  <%= field.input :weight,
              required: true,
              label: "Weight",
              label_html: { class: "visually-hidden" },
              placeholder: "Weight *" %>
  <%= field.input :height,
              required: true,
              label: "Height",
              label_html: { class: "visually-hidden" },
              placeholder: "Height *" %>
  <%= field.input :belt, collection: User::BELTS,
              required: false,
              label: "Belt",
              label_html: { class: "visually-hidden" },
              prompt: "Belt" %>
  <%= field.input :years_of_experience,
              required: false,
              label: "Years of experience",
              label_html: { class: "visually-hidden" },
              placeholder: "Years of experience *" %>
  <%= field.input :training_style, collection: User::TRAINING_STYLES,
              required: true,
              label: "Training style",
              label_html: { class: "visually-hidden" },
              prompt: "Training style *" %>
  <%= field.input :description,
              as: :text,
              required: false,
              label: "Description",
              label_html: { class: "visually-hidden" },
              placeholder: "Description" %>
  <%= field.input :email,
              required: true,
              label: "Email",
              label_html: { class: "visually-hidden" },
              placeholder: "Email *",
              input_html: { autocomplete: "email" }%>
  <%= field.input :password,
              required: true,
              label: "Password",
              label_html: { class: "visually-hidden" },
              placeholder: "Password *",
              hint: ("#{@minimum_password_length} characters minimum" if @minimum_password_length),
              input_html: { autocomplete: "new-password" } %>
  <%= field.input :password_confirmation,
              required: true,
              label: "Password confirmation",
              label_html: { class: "visually-hidden" },
              placeholder: "Password confirmation *",
              input_html: { autocomplete: "new-password" } %>
  <%= field.input :photo, as: :file,
              required: false,
              label: "Profile photo" %>
</div>
<div class="form-actions">
  <%= field.button :submit, @message, class: "btn btn-primary d-block w-100" %>
</div>
