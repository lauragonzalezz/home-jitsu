<div class="component-container" data-controller="advanced-search">
  <div class="form-box bg-light-grey">
    <%# TODO: Logic for search and advanced search %>
   <%= form_with url: events_path, method: :get, class: "d-flex" do |form| %>
      <%= label_tag :query, "Find events close to this address", class: "visually-hidden" %>
      <%= text_field_tag :query,
        params[:query],
        class: "form-control search-icon",
        placeholder: "Find events close to this address"
      %>
      <button type="button" class="purple-circle-button" data-advanced-search-target="toggler" aria-label="Advanced search"><%= image_tag "icons/sliders.svg", alt: "", width: 20 %></button>
    <% end %>
  </div>

  <div id="advanced-search" data-advanced-search-target="search">
    <%= render 'shared/back_bar', link: "#" %>
    <div class="container">
      <h2>Find an event</h2>
      <div class="component-container">
        <div class="form-box bg-white new-review">
          <%= form_with url: events_path, method: :get do |form| %>
            <%= label_tag "advanced-query", "Find events close to this address", class: "visually-hidden" %>
            <%= text_field_tag :query,
              params[:query],
              id: "advanced-query",
              class: "form-control mb-3",
              placeholder: "Close to this address"
            %>

            <%= label_tag "advanced-name", "Host name", class: "visually-hidden" %>
            <%= text_field_tag :name,
              params[:name],
              id: "advanced-name",
              class: "form-control mb-3",
              placeholder: "Host name"
            %>

            <%= label_tag "advanced-date", "Event date", class: "visually-hidden" %>
            <%= date_field_tag "date",
              params[:date],
              id: "advanced-date",
              class: "form-control",
              placeholder: "Date"
            %>
            <div class="form-text mb-3">Specific date for the event</div>
            <%= form.submit "Search for events", class: "btn btn-primary d-block w-100" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div id='map' style="width: 100%; height: 200px;"
    data-controller="map"
    data-map-markers-value="<%= @markers.to_json %>"
    data-map-api-key-value="<%= ENV['MAPBOX_API_KEY'] %>">
  </div>
  <% @events.each do |event| %>
    <% if event.date.future? %>
      <%= render "shared/event", event: event %>
    <% end %>
  <% end %>
</div>
