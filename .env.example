# Copy this file to .env and fill in the values. .env is gitignored.
# dotenv-rails loads it automatically in development and test.

# Mapbox GL token. Needed for the maps on the events pages to render.
# Free tier: https://account.mapbox.com/access-tokens/
MAPBOX_API_KEY=

# Cloudinary (image storage + rendering). REQUIRED in development: the app
# serves all photos through Cloudinary view helpers and uploads to Cloudinary,
# so seeding and page rendering both need this. Free tier is fine.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Host used to build absolute URLs (mailers, notifications).
# Defaults to localhost:3000 when unset.
DOMAIN=localhost:3000

# --- Database ---
# These default to the Dockerized Postgres service in compose.yaml, so you
# normally do NOT need to set them. Override only to point at another database.
# DATABASE_HOST=db
# DATABASE_USER=postgres
# DATABASE_PASSWORD=postgres
# DATABASE_PORT=5432
